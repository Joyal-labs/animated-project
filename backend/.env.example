# Django Core Settings
SECRET_KEY=django-insecure-rolex-concierge-luxury-key-2026-secret-token-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MySQL)
# Set DB_ENGINE=sqlite3 to use local SQLite database, or mysql to connect to MySQL
DB_ENGINE=mysql
DB_NAME=rolex_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration (allows frontend to communicate with API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Email Configuration
# Default to console backend during development to print outgoing emails in terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.gmail@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=Rolex Concierge <your.gmail@gmail.com>
ADMIN_NOTIFICATION_EMAIL=your.gmail@gmail.com
SEND_CUSTOMER_CONFIRMATION=True
